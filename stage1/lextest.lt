int isspace(int c) {
	if (c == 32) { return 1; }
	if (c == 10) { return 1; }
	return 0;
}

int skip(int src, int *pos) {
	int c = bload(src, *pos);
	while (isspace(c)) {
		*pos = *pos + 1;
		c = bload(src, *pos);
	}
	return c;
}

int src = "  hello";
int pos = 0;
int c = skip(src, &pos);
putint(c);
putstr("\n");
putint(pos);
putstr("\n");
